{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev && npm ci --prefix revive-painel --include=dev",
  "buildCommand": "npm run build:web",
  "outputDirectory": "revive-painel/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 15
    }
  },
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/asset-manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
