# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=

# JWT
JWT_SECRET=

# Opcional: para homologacao local em rede, inclua tambem http://SEU_IP:5173
ALLOWED_ORIGINS=

# API local
PORT=3000
NODE_ENV=development

# Password recovery: use a TLS SMTP provider and a verified sender.
# For a disposable local inbox only: SMTP_HOST=127.0.0.1, SMTP_PORT=1025.
# Enable only after all API instances support credential versions.
PASSWORD_RECOVERY_ENABLED=false

# Web v2: habilitar somente após todas as migrations (incluindo logout de família)
# e conferir HTTPS no ambiente. O painel novo depende desta flag.
WEB_AUTH_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RECOVERY_EMAIL_FROM=
